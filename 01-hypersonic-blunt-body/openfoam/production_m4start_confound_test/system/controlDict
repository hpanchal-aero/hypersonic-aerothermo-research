FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Production mesh, M=4->7 inlet ramp (see 0/U). LONG RESTART to t=1e-4 s.
//
// HISTORICAL NOTE (2026-09-29): this run was launched to test whether the
// low p_stag seen at t~1e-5 s was an impulsive-start transient that would
// relax toward the M=7 Pitot value. It did not: p_stag fell from ~43% to
// ~31% of the M=7 Pitot value. Cause: the ramp changes only the INLET
// boundary condition; the domain interior (0/U internalField) starts at the
// ramp-start velocity (M=4), so the body was still seeing M=4 gas at
// t=1e-4 s. This run therefore characterises an M=4 flow, NOT M=7.
// See DEVELOPMENT_LOG.md, entry 2026-09-29, for the full diagnosis and the
// field-based reinitialisation used to reach genuine M=7 conditions.
//
// Output is run-time based (every 2e-6 s), no purging; probes write every
// timestep. Kept as a record of the confound test, not as an M=7 baseline.

application     rhoCentralFoam;

startFrom       latestTime;
startTime       0;

stopAt          endTime;
endTime         1e-4;

deltaT          1e-10;

writeControl    adjustableRunTime;
writeInterval   2e-6;

purgeWrite      0;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       1e-6;

functions
{
    probeStagnation
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (T p U);
        probeLocations
        (
            (0 0 0)
        );
    }
    probeForebody
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (T p);
        probeLocations
        (
            (0.03856145 0.04869434 0.00000000)
            (0.13125550 0.07352789 0.00000000)
            (0.22394980 0.09836142 0.00000000)
            (0.31664380 0.12319510 0.00000000)
            (0.41184330 0.14869960 0.00000000)
        );
    }
}
