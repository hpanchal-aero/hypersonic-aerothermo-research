FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Shakedown B: same validated Mach-ramp as Shakedown A (M=5->7 over 5e-8s).
// p and T are NOT ramped (see Shakedown A rationale - Mach depends only on U
// at fixed altitude).

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1508.4 0 0);

boundaryField
{
    farfield_upstream
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0        (1508.4  0 0))
            (5e-08    (2111.72 0 0))
        );
    }
    farfield_outer
    {
        type            uniformFixedValue;
        uniformValue    table
        (
            (0        (1508.4  0 0))
            (5e-08    (2111.72 0 0))
        );
    }
    outlet
    {
        type            zeroGradient;
    }
    wall_nose
    {
        type            noSlip;
    }
    wall_cone
    {
        type            noSlip;
    }
    wall_fillet
    {
        type            noSlip;
    }
    wall_base
    {
        type            noSlip;
    }
    frontWedge
    {
        type            wedge;
    }
    backWedge
    {
        type            wedge;
    }
}

