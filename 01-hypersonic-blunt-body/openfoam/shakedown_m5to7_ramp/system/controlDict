FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Mach-ramp shakedown: unmodified adaptive-timestep settings (same as
// every other shakedown case), only the inlet BC differs (Mach ramp,
// see 0/U). endTime set well past the 5e-8s ramp window to observe
// post-ramp M=7 behavior.

application     rhoCentralFoam;

startFrom       latestTime;
startTime       0;

stopAt          endTime;
endTime         1e-6;

deltaT          1e-10;

writeControl    timeStep;
writeInterval   2;

purgeWrite      20;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;
maxCo           0.5;
maxDeltaT       1e-6;

functions
{
    probeStagnation
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   1;
        fields          (T p U);
        probeLocations
        (
            (0 0 0)
        );
    }
}
